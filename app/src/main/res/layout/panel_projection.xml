<?xml version="1.0" encoding="utf-8"?>
<!--
  Part 2 – right two-thirds of the head unit.
  Placeholder / launcher for the CarPlay/Android Auto app installed on the
  unit. The target app is picked in Settings; tapping the panel opens it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/panel_projection_background">

    <!-- Phone ··· projection glyph row -->
    <LinearLayout
        android:id="@+id/row_projection_icons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/icon_projection_phone"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_phone_projection"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:text="···"
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:letterSpacing="0.3" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_projection_glyph"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Large app icon (visible once a projection app is configured) -->
    <ImageView
        android:id="@+id/icon_projection_app"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="22dp"
        android:contentDescription="@string/settings_projection_app"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_projection_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/projection_default_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center" />

    <TextView
        android:id="@+id/text_projection_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/projection_not_connected"
        android:textColor="@color/text_secondary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-light"
        android:gravity="center" />

    <TextView
        android:id="@+id/text_projection_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/projection_hint"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/button_projection_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_chip"
        android:drawableStart="@drawable/ic_settings"
        android:drawablePadding="10dp"
        android:drawableTint="@color/text_primary"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="26dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/settings_button"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />
</LinearLayout>
